# ========================================
# Environment Variables (Optional)
# ========================================

# PORT is automatically set by Railway
# Locally defaults to 8000
# PORT=8000

# Flask environment (development or production)
# FLASK_ENV=production

# Optional: Secret key for session management
# SECRET_KEY=your-secret-key-here

# Optional: CORS origins (if you want to restrict)
# CORS_ORIGINS=https://your-domain.com,https://another-domain.com

# ========================================
# NOTE: This app stores configuration in browser localStorage
# So most settings are configured via the web interface
# ========================================
